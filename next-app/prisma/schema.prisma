model ContactRequest {
  id             String        @id @default(uuid())
  name           String        @db.VarChar(120)
  phone          String        @db.VarChar(20)
  email          String?       @db.VarChar(255)
  message        String        @db.Text
  idempotencyKey String?       @unique @db.VarChar(100)
  requestHash    String?       @db.VarChar(64)
  status         ContactStatus @default(new)
  adminNotes     AdminNote[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model AdminUser {
  id                 String      @id @default(uuid())
  email              String      @unique @db.VarChar(255)
  name               String      @db.VarChar(120)
  passwordHash       String      @db.VarChar(255)
  role               AdminRole   @default(staff)
  assignedBranchId   String?
  assignedBranch     Branch?     @relation(fields: [assignedBranchId], references: [id], onDelete: SetNull)
  isActive           Boolean     @default(true)
  mustChangePassword Boolean     @default(false)
  sessionVersion     Int         @default(1)
  twoFactorEnabled   Boolean     @default(false)
  twoFactorSecret    String?     @db.Text
  twoFactorPendingSecret String? @db.Text
  twoFactorConfirmedAt DateTime? @db.Timestamptz(3)
  twoFactorLastUsedStep Int?
  passwordChangedAt  DateTime?   @db.Timestamptz(3)
  lastLoginAt        DateTime?   @db.Timestamptz(3)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  notes              AdminNote[]
  auditLogs          AuditLog[]
  recoveryCodes      TwoFactorRecoveryCode[]

  @@index([role, isActive])
  @@index([assignedBranchId])
}

model MediaAsset {
  id         String    @id @default(uuid())
  storageKey String    @unique @db.VarChar(500)
  url        String    @db.VarChar(1000)
  filename   String    @db.VarChar(255)
  mimeType   String    @db.VarChar(100)
  sizeBytes  Int
  width      Int?
  height     Int?
  branchId   String?
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roomId     String?
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([branchId])
  @@index([roomId])
  @@index([menuItemId])
}
model AuthLoginAttempt {
  identifierHash  String    @id @db.VarChar(64)
  attemptCount    Int       @default(0)
  windowStartedAt DateTime  @db.Timestamptz(3)
  blockedUntil    DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}

model TwoFactorRecoveryCode {
  id          String    @id @default(uuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  codeHash    String    @unique @db.VarChar(64)
  usedAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now())

  @@index([adminUserId, usedAt])
}

model AdminNote {
  id               String          @id @default(uuid())
  authorId         String
  author           AdminUser       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  bookingId        String?
  booking          Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  contactRequestId String?
  contactRequest   ContactRequest? @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  content          String          @db.Text
  createdAt        DateTime        @default(now())

  @@index([bookingId, createdAt])
  @@index([contactRequestId, createdAt])
}

model AuditLog {
  id            String     @id @default(uuid())
  actorId       String?
  actor         AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole     String     @db.VarChar(30)
  action        String     @db.VarChar(80)
  entityType    String     @db.VarChar(40)
  entityId      String
  oldValue      Json?
  newValue      Json?
  metadata      Json?
  requestId     String?    @db.VarChar(100)
  ipAddressHash String?    @db.VarChar(64)
  userAgent     String?    @db.VarChar(300)
  result        String?    @db.VarChar(30)
  createdAt     DateTime   @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model SecurityRateLimit {
  keyHash         String    @id @db.VarChar(64)
  scope           String    @db.VarChar(60)
  count           Int       @default(0)
  windowStartedAt DateTime  @db.Timestamptz(3)
  blockedUntil    DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt

  @@index([scope, blockedUntil])
  @@index([updatedAt])
}

model OutboxEvent {
  id             String                 @id @default(uuid())
  eventType      OutboxEventType
  aggregateType  String                 @db.VarChar(40)
  aggregateId    String
  payload        Json
  idempotencyKey String                 @unique @db.VarChar(180)
  status         OutboxStatus           @default(pending)
  attemptCount   Int                    @default(0)
  nextAttemptAt  DateTime               @default(now()) @db.Timestamptz(3)
  lockedAt       DateTime?              @db.Timestamptz(3)
  lockToken      String?                @db.VarChar(100)
  processedAt    DateTime?              @db.Timestamptz(3)
  lastError      String?                @db.VarChar(500)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deliveries     NotificationDelivery[]

  @@index([status, nextAttemptAt, createdAt])
  @@index([aggregateType, aggregateId])
}

model NotificationDelivery {
  id                String              @id @default(uuid())
  outboxEventId     String
  outboxEvent       OutboxEvent         @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  bookingId         String?
  booking           Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  channel           NotificationChannel
  recipientHash     String              @db.VarChar(64)
  recipientMasked   String              @db.VarChar(255)
  template          String              @db.VarChar(80)
  status            DeliveryStatus
  providerMessageId String?             @db.VarChar(255)
  attemptCount      Int                 @default(0)
  errorSummary      String?             @db.VarChar(500)
  sentAt            DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([outboxEventId, channel, recipientHash])
  @@index([bookingId, createdAt])
