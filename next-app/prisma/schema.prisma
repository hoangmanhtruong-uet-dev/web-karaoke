// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Branch - Chi nhánh karaoke
model Branch {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  address      String
  district     String
  city         String
  phone        String
  email        String?      @db.VarChar(255)
  openingHours Json
  amenities    Json
  status       BranchStatus @default(active)
  imageUrl     String?      @db.VarChar(500)
  rooms        Room[]
  bookings     Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Room - Các phòng tại chi nhánh
model Room {
  id         String     @id @default(uuid())
  branchId   String
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name       String
  slug       String     @unique
  tier       RoomTier
  capacity   Json
  hourlyRate Int
  features   Json
  status     RoomStatus @default(available)
  imageUrl   String?    @db.VarChar(500)
  bookings   Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([tier])
  @@index([status])
}

// MenuItem - Các món trong menu
model MenuItem {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  category    MenuCategory
  description String
  price       Int
  imageUrl    String?           @db.VarChar(500)
  isSignature Boolean           @default(false)
  isAvailable Boolean           @default(true)
  bookings    BookingMenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Customer - Hồ sơ CRM, tách khỏi dữ liệu snapshot trên từng booking
model Customer {
  id             String         @id @default(uuid())
  fullName       String         @db.VarChar(120)
  phone          String         @unique @db.VarChar(20)
  email          String?        @db.VarChar(255)
  birthday       DateTime?      @db.Date
  membershipTier MembershipTier @default(regular)
  loyaltyPoints  Int            @default(0)
  status         CustomerStatus @default(active)
  note           String?        @db.Text
  bookings       Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([membershipTier, status])
}

// Service - Dịch vụ gọi thêm ngoài tiền phòng và menu
model Service {
  id          String           @id @default(uuid())
  name        String           @db.VarChar(120)
  slug        String           @unique
  category    ServiceCategory
  description String           @db.Text
  unit        ServiceUnit
  price       Int
  isAvailable Boolean          @default(true)
  imageUrl    String?          @db.VarChar(500)
  bookings    BookingService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isAvailable])
}

// Booking - Đơn đặt phòng
model Booking {
  id             String        @id @default(uuid())
  code           String        @unique @db.VarChar(20)
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  roomId         String?
  room           Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  customerName   String
  customerPhone  String
  customerEmail  String?       @db.VarChar(255)
  guestCount     Int
  date           String
  startTime      String
  durationHours  Int           @default(3)
  startAt        DateTime?     @db.Timestamptz(3)
  endAt          DateTime?     @db.Timestamptz(3)
  idempotencyKey String?       @unique @db.VarChar(100)
  requestHash    String?       @db.VarChar(64)
  status         BookingStatus @default(pending)
  source         BookingSource @default(website)
  expiresAt      DateTime?     @db.Timestamptz(3)
  confirmedAt    DateTime?     @db.Timestamptz(3)
  cancelledAt    DateTime?     @db.Timestamptz(3)
  rejectedAt     DateTime?     @db.Timestamptz(3)
  checkedInAt    DateTime?     @db.Timestamptz(3)
  expiredAt      DateTime?     @db.Timestamptz(3)
  note           String?       @db.Text
  totalAmount    Int?
  paidAmount     Int           @default(0)

  menuItems              BookingMenuItem[]
  services               BookingService[]
  payments               Payment[]
  adminNotes             AdminNote[]
  notificationDeliveries NotificationDelivery[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([branchId])
  @@index([customerId])
  @@index([roomId])
  @@index([status, date])
  @@index([roomId, startAt, endAt, status])
  @@index([status, startAt])
  @@index([status, expiresAt])
  @@index([customerPhone])
}

// ContactRequest - Yêu cầu tư vấn gửi từ contact form
model ContactRequest {
  id             String        @id @default(uuid())
  name           String        @db.VarChar(120)
  phone          String        @db.VarChar(20)
  email          String?       @db.VarChar(255)
  message        String        @db.Text
  idempotencyKey String?       @unique @db.VarChar(100)
  requestHash    String?       @db.VarChar(64)
  status         ContactStatus @default(new)
  adminNotes     AdminNote[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model AdminUser {
  id                 String      @id @default(uuid())
  email              String      @unique @db.VarChar(255)
  name               String      @db.VarChar(120)
  passwordHash       String      @db.VarChar(255)
  role               AdminRole   @default(staff)
  isActive           Boolean     @default(true)
  mustChangePassword Boolean     @default(false)
  sessionVersion     Int         @default(1)
  passwordChangedAt  DateTime?   @db.Timestamptz(3)
  lastLoginAt        DateTime?   @db.Timestamptz(3)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  notes              AdminNote[]
  auditLogs          AuditLog[]

  @@index([role, isActive])
}

model AuthLoginAttempt {
  identifierHash  String    @id @db.VarChar(64)
  attemptCount    Int       @default(0)
  windowStartedAt DateTime  @db.Timestamptz(3)
  blockedUntil    DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}

model AdminNote {
  id               String          @id @default(uuid())
  authorId         String
  author           AdminUser       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  bookingId        String?
  booking          Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  contactRequestId String?
  contactRequest   ContactRequest? @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  content          String          @db.Text
  createdAt        DateTime        @default(now())

  @@index([bookingId, createdAt])
  @@index([contactRequestId, createdAt])
}

model AuditLog {
  id            String     @id @default(uuid())
  actorId       String?
  actor         AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole     String     @db.VarChar(30)
  action        String     @db.VarChar(80)
  entityType    String     @db.VarChar(40)
  entityId      String
  oldValue      Json?
  newValue      Json?
  metadata      Json?
  requestId     String?    @db.VarChar(100)
  ipAddressHash String?    @db.VarChar(64)
  userAgent     String?    @db.VarChar(300)
  result        String?    @db.VarChar(30)
  createdAt     DateTime   @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model SecurityRateLimit {
  keyHash         String    @id @db.VarChar(64)
  scope           String    @db.VarChar(60)
  count           Int       @default(0)
  windowStartedAt DateTime  @db.Timestamptz(3)
  blockedUntil    DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt

  @@index([scope, blockedUntil])
  @@index([updatedAt])
}

model OutboxEvent {
  id             String                 @id @default(uuid())
  eventType      OutboxEventType
  aggregateType  String                 @db.VarChar(40)
  aggregateId    String
  payload        Json
  idempotencyKey String                 @unique @db.VarChar(180)
  status         OutboxStatus           @default(pending)
  attemptCount   Int                    @default(0)
  nextAttemptAt  DateTime               @default(now()) @db.Timestamptz(3)
  lockedAt       DateTime?              @db.Timestamptz(3)
  lockToken      String?                @db.VarChar(100)
  processedAt    DateTime?              @db.Timestamptz(3)
  lastError      String?                @db.VarChar(500)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deliveries     NotificationDelivery[]

  @@index([status, nextAttemptAt, createdAt])
  @@index([aggregateType, aggregateId])
}

model NotificationDelivery {
  id                String              @id @default(uuid())
  outboxEventId     String
  outboxEvent       OutboxEvent         @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  bookingId         String?
  booking           Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  channel           NotificationChannel
  recipientHash     String              @db.VarChar(64)
  recipientMasked   String              @db.VarChar(255)
  template          String              @db.VarChar(80)
  status            DeliveryStatus
  providerMessageId String?             @db.VarChar(255)
  attemptCount      Int                 @default(0)
  errorSummary      String?             @db.VarChar(500)
  sentAt            DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([outboxEventId, channel, recipientHash])
  @@index([bookingId, createdAt])
  @@index([status, createdAt])
}

// BookingMenuItem - Mối quan hệ nhiều-nhiều giữa Booking và MenuItem
model BookingMenuItem {
  id         String @id @default(uuid())
  bookingId  String
  menuItemId String
  quantity   Int    @default(1)
  price      Int // Lưu giá tại thời điểm đặt (để tránh thay đổi sau này)

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([bookingId, menuItemId])
}

// BookingService - Lưu giá dịch vụ tại thời điểm khách đặt
model BookingService {
  id        String  @id @default(uuid())
  bookingId String
  serviceId String
  quantity  Int     @default(1)
  unitPrice Int
  note      String? @db.Text

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([bookingId, serviceId])
  @@index([serviceId])
}

// Payment - Lịch sử giao dịch; paidAmount trên Booking là số tổng hợp nhanh
model Payment {
  id              String        @id @default(uuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount          Int
  method          PaymentMethod
  status          PaymentStatus @default(pending)
  transactionCode String?       @unique @db.VarChar(100)
  paidAt          DateTime?     @db.Timestamptz(3)
  note            String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId, status, createdAt])
  @@index([status, paidAt])
}

// Enum types
enum BranchStatus {
  active
  maintenance
  comingSoon  @map("coming-soon")
}

enum RoomTier {
  standard
  vip
  premium
  presidential
}

enum RoomStatus {
  available
  occupied
  maintenance
}

enum MenuCategory {
  drink
  food
  combo
  fruit
  snack
}

enum MembershipTier {
  regular
  silver
  gold
  diamond
}

enum CustomerStatus {
  active
  blocked
}

enum ServiceCategory {
  staff
  decoration
  equipment
  event
  other
}

enum ServiceUnit {
  perBooking
  perHour
  perPerson
  perItem
}

enum PaymentMethod {
  cash
  bankTransfer
  card
  eWallet
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum BookingStatus {
  pending
  confirmed
  checkedIn
  completed
  cancelled
  rejected
  expired
}

enum ContactStatus {
  new
  inProgress
  resolved
  spam
}

enum AdminRole {
  user
  staff
  manager
  admin
}

enum BookingSource {
  website
  admin
  phone
}

enum OutboxEventType {
  bookingCreated
  bookingConfirmed
  bookingRejected
  bookingCancelled
  bookingExpired
  bookingRoomChanged
  bookingReminder
  contactRequestCreated
}

enum OutboxStatus {
  pending
  processing
  processed
  failed
  deadLetter
}

enum NotificationChannel {
  email
  internal
}

enum DeliveryStatus {
  pending
  sent
  failed
}
