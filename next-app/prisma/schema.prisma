model Booking {
  id             String        @id @default(uuid())
  code           String        @unique @db.VarChar(20)
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  roomId         String?
  room           Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  customerName   String
  customerPhone  String
  customerEmail  String?       @db.VarChar(255)
  guestCount     Int
  date           String
  startTime      String
  durationHours  Int           @default(3)
  startAt        DateTime?     @db.Timestamptz(3)
  endAt          DateTime?     @db.Timestamptz(3)
  idempotencyKey String?       @unique @db.VarChar(100)
  requestHash    String?       @db.VarChar(64)
  status         BookingStatus @default(pending)
  source         BookingSource @default(website)
  expiresAt      DateTime?     @db.Timestamptz(3)
  confirmedAt    DateTime?     @db.Timestamptz(3)
  cancelledAt    DateTime?     @db.Timestamptz(3)
  rejectedAt     DateTime?     @db.Timestamptz(3)
  checkedInAt    DateTime?     @db.Timestamptz(3)
  expiredAt      DateTime?     @db.Timestamptz(3)
  note           String?       @db.Text
  totalAmount    Int?
  paidAmount     Int           @default(0)
  roomAmount     Int?
  priceSnapshot  Json?

  menuItems              BookingMenuItem[]
  services               BookingService[]
  payments               Payment[]
  adminNotes             AdminNote[]
  notificationDeliveries NotificationDelivery[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([branchId])
  @@index([customerId])
  @@index([roomId])
  @@index([status, date])
  @@index([roomId, startAt, endAt, status])
  @@index([status, startAt])
  @@index([status, expiresAt])
  @@index([customerPhone])
}

