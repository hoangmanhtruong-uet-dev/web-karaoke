  expiresAt       DateTime?     @db.Timestamptz(3)
  lastWebhookId   String?       @db.VarChar(180)
  transactionCode String?       @unique @db.VarChar(100)
  paidAt          DateTime?     @db.Timestamptz(3)
  note            String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId, status, createdAt])
  @@index([status, paidAt])
  @@unique([provider, providerPaymentId])
}

model PricingRule {
  id String @id @default(uuid())
  name String @db.VarChar(120)
  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roomId String?
  room Room? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomTier RoomTier?
  ruleType PricingRuleType @default(regular)
  specificDate DateTime? @db.Date
  dayOfWeek Int?
  startMinute Int @default(0)
  endMinute Int @default(1440)
  hourlyRate Int
  priority Int
  validFrom DateTime @db.Date
  validTo DateTime? @db.Date
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([branchId, isActive, validFrom, validTo])
  @@index([roomId, roomTier, priority])
}

