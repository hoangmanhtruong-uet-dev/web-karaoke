
# Media storage (Supabase Storage; never use serverless local filesystem)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=admin-media

# Database TLS (production requires verify-full and a trusted CA)
DATABASE_URL=postgresql://user:password@localhost:5432/web_karaoke
DATABASE_SSL_CA_BASE64=
DATABASE_SSL_CA_PEM=
DATABASE_SSL_CA_FILE=
DATABASE_SSL_ALLOW_UNVERIFIED=false

# Authentication and admin 2FA
AUTH_SECRET=
SECURITY_EVENT_HASH_SECRET=
TOTP_ENCRYPTION_KEY=
RECOVERY_CODE_HASH_SECRET=
# Generate TOTP_ENCRYPTION_KEY with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
