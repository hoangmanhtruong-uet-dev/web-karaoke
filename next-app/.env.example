
# Media storage (Supabase Storage; never use serverless local filesystem)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=admin-media

# Database TLS (production requires verify-full and a trusted CA)
DATABASE_URL=postgresql://user:password@localhost:5432/web_karaoke
DATABASE_SSL_CA_BASE64=
DATABASE_SSL_CA_PEM=
DATABASE_SSL_CA_FILE=
DATABASE_SSL_ALLOW_UNVERIFIED=false

# Authentication and admin 2FA
AUTH_SECRET=
SECURITY_EVENT_HASH_SECRET=
TOTP_ENCRYPTION_KEY=
RECOVERY_CODE_HASH_SECRET=
# Generate TOTP_ENCRYPTION_KEY with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Isolated integration-test database. The database name must end with _test.
# Never copy the production/Aiven URL here.
TEST_DATABASE_URL=
PRODUCTION_DATABASE_HOSTS=
ALLOW_REMOTE_TEST_DATABASE=false
# Canonical production origin and Auth.js proxy settings
PRODUCTION_CANONICAL_ORIGIN=
AUTH_URL=
AUTH_TRUST_HOST=false
TRUSTED_PROXY_MODE=
PRODUCTION_EXPECTED_PROXY_MODE=

# Public brand/contact values (replace every value before production deploy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_OG_IMAGE=/images/placeholders/general-placeholder.svg
NEXT_PUBLIC_BRAND_NAME=Royal Karaoke
NEXT_PUBLIC_SHORT_NAME=Royal
NEXT_PUBLIC_SITE_DESCRIPTION=
NEXT_PUBLIC_SITE_SHORT_DESCRIPTION=
NEXT_PUBLIC_SITE_TAGLINE=
NEXT_PUBLIC_HOTLINE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_ZALO_URL=
NEXT_PUBLIC_MESSENGER_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_BRANCH_SUMMARY=
NEXT_PUBLIC_OPENING_HOURS=

# Notification delivery and scheduled jobs
CRON_SECRET=
EMAIL_PROVIDER=disabled
EMAIL_FROM=
EMAIL_WEBHOOK_URL=
EMAIL_API_KEY=
ADMIN_NOTIFICATION_EMAIL=

# Optional payment webhook. Leave both empty when payments are disabled.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
