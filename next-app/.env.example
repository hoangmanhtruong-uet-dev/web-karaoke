# Database (update this for production)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
SHADOW_DATABASE_URL="postgresql://user:password@host:5432/shadow?schema=public"
DATABASE_SSL_CA_BASE64=
# Development/test escape hatch only; ignored in production.
DATABASE_SSL_ALLOW_UNVERIFIED=false
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_CONNECTION_LIFETIME_SECONDS=300
DATABASE_TRANSACTION_MAX_WAIT_MS=3000
DATABASE_TRANSACTION_TIMEOUT_MS=10000

# Optional (defaults to relative URLs)
# NEXT_PUBLIC_API_URL=http://localhost:3000

# Auth.js (generate with: npx auth secret)
AUTH_SECRET=
AUTH_URL=https://karaoke.example.com
# Verification-only expected values; set them for `npm run verify:production-env`.
PRODUCTION_CANONICAL_ORIGIN=https://karaoke.example.com
AUTH_TRUST_HOST=false
TRUSTED_PROXY_MODE=
PRODUCTION_EXPECTED_PROXY_MODE=
SECURITY_EVENT_HASH_SECRET=

# Booking lifecycle and jobs
BOOKING_HOLD_MINUTES=15
BOOKING_REMINDER_MINUTES=120
JOB_BATCH_SIZE=25
CRON_SECRET=

# Notification provider: console (development only) or webhook
EMAIL_PROVIDER=console
# Use disabled in production only when external delivery is intentionally paused.
EMAIL_FROM=
EMAIL_API_KEY=
EMAIL_WEBHOOK_URL=
ADMIN_NOTIFICATION_EMAIL=

# Optional first-admin creation through `npm run prisma:seed`
# Development/test only. Production must use the explicit one-time admin:bootstrap command.
ALLOW_DEV_ADMIN_SEED=false
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=

# One-time production bootstrap. Remove all values immediately after success.
ALLOW_ADMIN_BOOTSTRAP=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
